/*
 * Top Player skin template.
 *
 * Every @name@ below is a token, filled in at runtime from the current
 * appearance (theme x accent x style) by Theme::styleSheet() in
 * src/Theme.cpp, which lists them all. Write colors, radii and fills as
 * tokens, never as literal values, so the rule follows every theme.
 *
 *   surfaces   @surface@ @panel@ @raised@ @border@ @hover@ @pressed@
 *   text       @text@ @text2@ @textDim@ @rowText@
 *   accent     @accent@ @accentHover@ @accentDeep@ @accent2@ @accentTint@
 *              @accentTintStrong@ @onAccent@
 *   fills      @accentFill@ @accentFillHover@ @accentFillV@ @selection@
 *   shapes     @radius@ @radiusSmall@ @radiusLarge@ @line@
 */

* {
    font-size: 9pt;
}

QMainWindow,
#RootWidget {
    background: @surface@;
}

QDialog {
    background: @panel@;
    color: @text@;
}

QLabel {
    color: @text@;
}

/* ---- Title bar ---------------------------------------------------------- */

#TitleBar {
    background: @titleBackground@;
    border-bottom: 1px solid @titleLine@;
    min-height: 32px;
    max-height: 32px;
}

#AppNameLabel {
    color: @accent@;
    font-weight: bold;
    letter-spacing: 0.3px;
    @headingFont@
}

#TitleLabel {
    color: @text2@;
}

/* The window buttons paint their own animated highlight. */
#TitleBar QToolButton {
    border: none;
    background: transparent;
}

/* ---- Control bar -------------------------------------------------------- */

#ControlBar {
    background: @controlBackground@;
    border-top: @line@ solid @border@;
}

/* Fullscreen and the mini player: the bar floats over the video. */
#ControlBar[overlay="true"] {
    background: @overlay@;
    border-top: 1px solid @overlayLine@;
}

#MiniRestoreButton {
    background: @miniBg@;
    border: 1px solid @miniLine@;
    border-radius: @radius@;
    padding: 5px;
}

#MiniRestoreButton:hover {
    background: @accentTint@;
    border-color: @accent@;
}

QToolButton {
    background: transparent;
    border: @toolBorder@;
    border-radius: @radiusSmall@;
    padding: 4px;
}

QToolButton:hover {
    background: @hover@;
}

QToolButton:pressed {
    background: @pressed@;
}

QToolButton:checked {
    @checkedRule@
}

/* The play button wears the accent. */
#ControlBar QToolButton#PlayButton {
    padding: 5px 7px;
    background: @playFill@;
    border: @playBorder@;
    border-radius: @radiusPlay@;
}

#ControlBar QToolButton#PlayButton:hover {
    background: @playFillHover@;
}

#ControlBar QToolButton#PlayButton:pressed {
    background: @accentDeep@;
}

#TimeLabel {
    color: @text@;
    font-family: "JetBrains Mono", "DejaVu Sans Mono", "Noto Sans Mono", monospace;
}

/* Custom-painted seekbar: colors are exposed as properties. */
SeekBar {
    qproperty-grooveColor: @groove@;
    qproperty-progressColor: @accent@;
    qproperty-progressColor2: @progressEnd@;
    qproperty-glowColor: @seekGlow@;
    qproperty-hoverColor: @progressHover@;
    qproperty-handleColor: @handle@;
    qproperty-chapterColor: @controlBackground@;
    /* The media cutter's clip, set apart from the accent progress. */
    qproperty-clipColor: @clip@;
    min-height: 18px;
}

/* ---- Buttons ------------------------------------------------------------ */

QPushButton {
    background: @raised@;
    color: @text@;
    border: @line@ solid @border@;
    border-radius: @radius@;
    padding: 5px 14px;
}

QPushButton:hover {
    background: @accentTint@;
    border-color: @accentHover@;
}

QPushButton:pressed {
    background: @accentTintStrong@;
}

QPushButton:default {
    border-color: @accent@;
}

QPushButton:checked {
    background: @accentFill@;
    color: @onAccent@;
    border-color: @accent@;
}

QPushButton:disabled {
    color: @textDim@;
    border-color: @raised@;
}

/* ---- Inputs ------------------------------------------------------------- */

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background: @field@;
    color: @text@;
    border: @line@ solid @border@;
    border-radius: @radiusSmall@;
    padding: 3px 5px;
    selection-background-color: @accent@;
    selection-color: @onAccent@;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    @focusRule@
}

QComboBox QAbstractItemView {
    background: @panel@;
    color: @text@;
    border: 1px solid @border@;
    selection-background-color: @accentTint@;
    selection-color: @text@;
}

QCheckBox,
QRadioButton {
    color: @text@;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid @borderStrong@;
    border-radius: @radiusCheck@;
    background: @field@;
}

QCheckBox::indicator:hover {
    border-color: @accentHover@;
}

QCheckBox::indicator:checked {
    background: @accentFill@;
    border-color: @accent@;
}

/* ---- Empty state (start screen) ----------------------------------------- */

#EmptyStateTitle {
    font-size: 20pt;
    font-weight: bold;
    @headingFont@
}

#EmptyStateTitle[compact="true"] {
    font-size: 14pt;
}

#EmptyStateHint {
    color: @textDim@;
    font-size: 9pt;
}

#EmptyStateHint[dropTarget="true"] {
    color: @accent@;
}

QPushButton[emptyStateAction="true"] {
    background: @cardFill@;
    color: @text@;
    border: @line@ solid @border@;
    border-radius: @radiusLarge@;
    padding: 9px 18px 9px 14px;
    min-width: 168px;
    min-height: 22px;
    text-align: left;
    font-size: 10pt;
}

QPushButton[emptyStateAction="true"][compact="true"] {
    min-width: 0;
    padding: 9px;
}

QPushButton[emptyStateAction="true"]:hover {
    background: @selection@;
    border-color: @accent@;
    color: @text@;
}

QPushButton[emptyStateAction="true"]:pressed {
    background: @accentTintStrong@;
}

/* ---- Sliders ------------------------------------------------------------ */

QSlider::groove:horizontal {
    height: 4px;
    background: @groove@;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: @accentFill@;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    margin: -3px 0;
    border-radius: 5px;
    background: @handle@;
}

QSlider::groove:vertical {
    width: 4px;
    background: @groove@;
    border-radius: 2px;
}

QSlider::add-page:vertical {
    background: @accentFillV@;
    border-radius: 2px;
}

QSlider::handle:vertical {
    width: 12px;
    height: 12px;
    margin: 0 -4px;
    border-radius: 6px;
    background: @handle@;
}

QSlider::handle:horizontal:hover,
QSlider::handle:vertical:hover {
    background: @accentHover@;
}

/* ---- Playlist drawer ---------------------------------------------------- */

#PlaylistDrawer {
    background: @panel@;
    border-left: @line@ solid @border@;
}

#PlaylistResizeHandle {
    background: transparent;
}

#PlaylistResizeHandle:hover {
    background: @accentGlow@;
}

QTabBar#PlaylistTabs::tab {
    background: transparent;
    color: @text2@;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 12px;
    font-weight: bold;
    @headingFont@
}

QTabBar#PlaylistTabs::tab:hover {
    color: @text@;
}

QTabBar#PlaylistTabs::tab:selected {
    color: @text@;
    border-bottom-color: @accent@;
}

#PlaylistCount {
    color: @text2@;
}

QLineEdit#PlaylistFilter {
    background: @field@;
    padding: 2px 4px;
}

#PlaylistDrawer QToolButton[hideMenuIndicator="true"]::menu-indicator {
    image: none;
    width: 0;
}

QListWidget#PlaylistView,
QListWidget#QueueView {
    background: @panel@;
    color: @rowText@;
    border: none;
    border-top: @line@ solid @border@;
    outline: none;
    padding: 2px 0;
}

QListWidget#PlaylistView::item,
QListWidget#QueueView::item {
    padding: 6px 10px;
    border: none;
}

QListWidget#PlaylistView::item:hover,
QListWidget#QueueView::item:hover {
    background: @raised@;
}

QListWidget#PlaylistView::item:selected,
QListWidget#QueueView::item:selected {
    background: @selection@;
    color: @text@;
}

/* PotPlayer's bottom bar: move buttons and ADD / DEL / SORT chips. */
#PlaylistActionBar, #LibraryActionBar, #QueueActionBar {
    background: @actionBar@;
    border-top: @line@ solid @border@;
}

#PlaylistActionBar QToolButton[barButton="true"], #LibraryActionBar QToolButton[barButton="true"], #QueueActionBar QToolButton[barButton="true"] {
    background: @chip@;
    color: @chipText@;
    border: 1px solid @chipBorder@;
    border-radius: @radiusSmall@;
    padding: 3px 6px;
    min-height: 16px;
}

#PlaylistActionBar QToolButton[barButton="true"]:disabled, #LibraryActionBar QToolButton[barButton="true"]:disabled, #QueueActionBar QToolButton[barButton="true"]:disabled {
    color: @chipDisabledText@;
    background: @chipDisabled@;
    border-color: @chip@;
}

#PlaylistActionBar QToolButton[barIcon="true"], #LibraryActionBar QToolButton[barIcon="true"], #QueueActionBar QToolButton[barIcon="true"] {
    padding: 3px 4px;
}

#PlaylistActionBar QToolButton[barButton="true"]:hover, #LibraryActionBar QToolButton[barButton="true"]:hover, #QueueActionBar QToolButton[barButton="true"]:hover {
    background: @chipHover@;
    color: @text@;
    border-color: @accent@;
}

#PlaylistActionBar QToolButton[barButton="true"]:pressed, #LibraryActionBar QToolButton[barButton="true"]:pressed, #QueueActionBar QToolButton[barButton="true"]:pressed,
#PlaylistActionBar QToolButton[barButton="true"]:open, #LibraryActionBar QToolButton[barButton="true"]:open, #QueueActionBar QToolButton[barButton="true"]:open {
    background: @accentTint@;
    color: @accent@;
    border-color: @accent@;
}

#PlaylistActionBar QToolButton::menu-indicator, #LibraryActionBar QToolButton::menu-indicator, #QueueActionBar QToolButton::menu-indicator {
    image: none;
    width: 0;
}

/* The queue page: where its songs come from, and the empty hint. */
#QueueSourceBar {
    background: @panel@;
}

#QueueSource {
    color: @text2@;
    font-weight: bold;
}

#QueueEmpty {
    color: @textDim@;
    background: @panel@;
    border-top: @line@ solid @border@;
    padding: 24px;
}

QTreeWidget#LibraryView {
    background: @panel@;
    color: @rowText@;
    border: none;
    border-top: @line@ solid @border@;
    outline: none;
    padding: 2px 0;
}

QTreeWidget#LibraryView::item {
    padding: 4px 2px;
    border: none;
}

QTreeWidget#LibraryView::item:hover {
    background: @raised@;
}

QTreeWidget#LibraryView::item:selected {
    background: @selection@;
    color: @text@;
}

/* ---- Menus -------------------------------------------------------------- */

QMenu {
    background: @panel@;
    color: @text@;
    border: 1px solid @borderStrong@;
    padding: 4px 0;
}

QMenu::item {
    padding: 5px 28px 5px 26px;
    background: transparent;
}

QMenu::item:selected {
    background: @menuSelection@;
    color: @menuSelectedText@;
}

QMenu::item:disabled {
    color: @textDim@;
}

QMenu::separator {
    height: 1px;
    background: @border@;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 12px;
    height: 12px;
    left: 8px;
}

QMenu::indicator:non-exclusive:checked,
QMenu::indicator:exclusive:checked {
    background: @accentFill@;
    border-radius: 2px;
}

QMenu::indicator:exclusive:checked {
    border-radius: 6px;
}

QMenu::right-arrow {
    width: 8px;
    height: 8px;
}

/* ---- Scroll bars -------------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: @scrollHandle@;
    border-radius: @radiusScroll@;
    min-height: 24px;
}

QScrollBar::handle:horizontal {
    background: @scrollHandle@;
    border-radius: @radiusScroll@;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: @accent@;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    height: 0;
    width: 0;
}

/* ---- Tooltips ----------------------------------------------------------- */

QToolTip {
    background: @panel@;
    color: @text@;
    border: 1px solid @borderStrong@;
    padding: 3px 6px;
}

/* ---- Item views in dialogs ---------------------------------------------- */

QTreeWidget#SubtitleResults {
    background: @field@;
    alternate-background-color: @altRow@;
    color: @text@;
    border: @line@ solid @border@;
    outline: none;
}

QTreeWidget#SubtitleResults::item {
    padding: 5px 6px;
    border: none;
}

QTreeWidget#SubtitleResults::item:hover {
    background: @raised@;
}

QTreeWidget#SubtitleResults::item:selected {
    background: @selection@;
    color: @text@;
}

QTreeWidget#SubtitleResults QHeaderView::section {
    background: @panel@;
    color: @text2@;
    border: none;
    border-right: 1px solid @border@;
    border-bottom: 1px solid @border@;
    padding: 5px 6px;
}

QProgressBar#SubtitleProgress {
    background: @raised@;
    border: none;
    border-radius: 2px;
}

QProgressBar#SubtitleProgress::chunk {
    background: @accentFill@;
    border-radius: 2px;
}

/* ---- About dialog ------------------------------------------------------- */

QDialog#AboutDialog {
    background: @surface@;
}

#AboutTitle {
    color: @text@;
    font-size: 16pt;
    font-weight: bold;
}

#AboutTagline,
#AboutLicense {
    color: @text2@;
}

#AboutByline {
    color: @text@;
    font-size: 10pt;
}

#AboutLinks {
    font-size: 10pt;
}

QFrame#AboutSystem {
    background: @panel@;
    border: @line@ solid @border@;
    border-radius: @radiusLarge@;
}

#AboutSystemHeading {
    color: @accent@;
    font-weight: bold;
    @headingFont@
}

#AboutSystem QLabel[role="key"] {
    color: @text2@;
}

#AboutSystem QLabel[role="value"] {
    color: @text@;
    font-family: "JetBrains Mono", "DejaVu Sans Mono", "Noto Sans Mono", monospace;
}

/* ---- Equalizer dialog --------------------------------------------------- */

QDialog#EqualizerDialog QLabel[role="band"] {
    color: @text2@;
    font-size: 8pt;
}

QDialog#EqualizerDialog QLabel[role="gain"] {
    color: @accent@;
    font-size: 8pt;
}

/* ---- Appearance dialog -------------------------------------------------- */

QDialog#AppearanceDialog {
    background: @surface@;
}

#AppearanceHeading {
    color: @text@;
    font-size: 15pt;
    font-weight: bold;
    @headingFont@
}

#AppearanceSubheading {
    color: @text2@;
}

QLabel[role="section"] {
    color: @accent@;
    font-weight: bold;
    letter-spacing: 1px;
    @headingFont@
}
