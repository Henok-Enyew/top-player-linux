#!/usr/bin/make -f
# Built by packaging/debian/build-deb.sh, which copies this directory to
# debian/ in a clean source tree and writes debian/changelog.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release

override_dh_auto_install:
	dh_auto_install
	# The license goes in /usr/share/doc/top-player/copyright instead.
	rm -rf debian/top-player/usr/share/licenses

override_dh_auto_test:
	desktop-file-validate packaging/linux/org.github.topplayer.desktop
	appstreamcli validate --no-net packaging/linux/org.github.topplayer.metainfo.xml
